# Copiar a .env (docker compose) y completar
DB_ROOT_PASSWORD=cambiar
DB_NAME=stamplab_db
DB_USER=usuario
DB_PASSWORD=cambiar
# Secreto para firmar sesiones (JWT). Usar un valor largo y aleatorio
JWT_SECRET=cambiar
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Recuperacion de contrasena (opcional): contrasena de aplicacion de Gmail
MAIL_USER=
MAIL_PASS=
FRONTEND_URL=http://localhost:5173
# Intentos fallidos de login por IP cada 15 min antes de bloquear (429)
AUTH_MAX_FALLOS=15
# Usar production en el servidor real (silencia logs de depuracion)
NODE_ENV=development
# URL publica del backend (las imagenes de productos se devuelven como PUBLIC_URL/uploads/...)
PUBLIC_URL=http://localhost:3000

# Puertos del equipo (cambiar si ya estan ocupados, p. ej. MySQL/MariaDB local en 3306)
HOST_DB_PORT=3306
HOST_BACKEND_PORT=3000
HOST_FRONTEND_PORT=5173
# URL del backend tal como la ve el NAVEGADOR (se incrusta al compilar el frontend)
VITE_API_URL=http://localhost:3000
