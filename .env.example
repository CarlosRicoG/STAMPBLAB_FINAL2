# Copiar a .env (docker compose) y completar
DB_ROOT_PASSWORD=cambiar
DB_NAME=stamplab_db
DB_USER=usuario
DB_PASSWORD=cambiar
# Secreto para firmar sesiones (JWT). Usar un valor largo y aleatorio
JWT_SECRET=cambiar
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Recuperacion de contrasena (opcional): contrasena de aplicacion de Gmail
MAIL_USER=
MAIL_PASS=
FRONTEND_URL=http://localhost:5173
# Intentos fallidos de login por IP cada 15 min antes de bloquear (429)
AUTH_MAX_FALLOS=15
# Solicitudes por IP y por hora a recuperar contraseña y registro (suben en pruebas automáticas)
RECUPERAR_MAX_HORA=5
REGISTRO_MAX_HORA=20
# Número de proxies delante de la API (1 en Vercel/Render/nginx); vacío si se accede directo
TRUST_PROXY=
# Usar production en el servidor real (silencia logs de depuracion)
NODE_ENV=development
# URL publica del backend (las imagenes de productos se devuelven como PUBLIC_URL/uploads/...)
PUBLIC_URL=http://localhost:3000

# Puertos del equipo (cambiar si ya estan ocupados, p. ej. MySQL/MariaDB local en 3306)
HOST_DB_PORT=3306
HOST_BACKEND_PORT=3000
HOST_FRONTEND_PORT=5173
# URL del backend tal como la ve el NAVEGADOR (se incrusta al compilar el frontend)
VITE_API_URL=http://localhost:3000

# ── Reglas del negocio (todas opcionales) ──
# Horas para pagar un pedido por transferencia antes de que se cancele solo (0 = nunca)
PLAZO_PAGO_HORAS=48
# Días sin respuesta antes de que una cotización pase a Vencida (0 = nunca)
# Días que un pedido contra entrega puede esperar antes de cancelarse solo (0 = nunca)
PLAZO_CONTRAENTREGA_DIAS=7
VIGENCIA_COTIZACION_DIAS=30
# Costo del envío a domicilio en pesos
COSTO_ENVIO=0
# Unidades por debajo de las cuales se avisa "stock bajo"
STOCK_MINIMO=5
# WhatsApp del negocio (solo dígitos con indicativo, ej. 573001234567): activa los botones "Escribir por WhatsApp"
WHATSAPP=
# Correo(s) del equipo que reciben los avisos (separados por coma). Si se deja vacío, se usa el correo de cada administrador
ADMIN_NOTIFY_EMAIL=
