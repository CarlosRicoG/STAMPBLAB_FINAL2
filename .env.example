# Copiar a .env (docker compose) y completar
DB_ROOT_PASSWORD=cambiar
DB_NAME=stamplab_db
DB_USER=usuario
DB_PASSWORD=cambiar
# Secreto para firmar sesiones (JWT). Usar un valor largo y aleatorio
JWT_SECRET=cambiar
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Recuperacion de contrasena (opcional): contrasena de aplicacion de Gmail
MAIL_USER=
MAIL_PASS=
FRONTEND_URL=http://localhost:5173
