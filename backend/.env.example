# Copiar a backend/.env para correr sin Docker
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stamplab_unificado
DB_USER=root
DB_PASSWORD=
JWT_SECRET=cambiar
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=3000
MAIL_USER=
MAIL_PASS=
FRONTEND_URL=http://localhost:5173
# Intentos fallidos de login por IP cada 15 min antes de bloquear (429)
AUTH_MAX_FALLOS=15
# Usar production en el servidor real (silencia logs de depuracion)
NODE_ENV=development
