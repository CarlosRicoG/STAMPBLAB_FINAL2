# Copiar a backend/.env para correr sin Docker
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stamplab_unificado
DB_USER=root
DB_PASSWORD=
JWT_SECRET=cambiar
# Orígenes del frontend separados por coma. Obligatorio con NODE_ENV=production (sin él la API no arranca)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=3000
MAIL_USER=
MAIL_PASS=
FRONTEND_URL=http://localhost:5173
# Intentos fallidos de login por IP cada 15 min antes de bloquear (429)
AUTH_MAX_FALLOS=15
# Solicitudes por IP y por hora a recuperar contraseña y registro (suben en pruebas automáticas)
RECUPERAR_MAX_HORA=5
REGISTRO_MAX_HORA=20
# Número de proxies delante de la API (1 en Vercel/Render/nginx); vacío si se accede directo
TRUST_PROXY=
# Usar production en el servidor real (silencia logs de depuracion)
NODE_ENV=development
# URL publica del backend (las imagenes de productos se devuelven como PUBLIC_URL/uploads/...)
PUBLIC_URL=http://localhost:3000

# ── Reglas del negocio (todas opcionales) ──
# Horas para pagar un pedido por transferencia antes de que se cancele solo (0 = nunca)
PLAZO_PAGO_HORAS=48
# Días que un pedido contra entrega puede esperar antes de cancelarse solo (0 = nunca)
PLAZO_CONTRAENTREGA_DIAS=7
# Días sin respuesta antes de que una cotización pase a Vencida (0 = nunca)
VIGENCIA_COTIZACION_DIAS=30
# Costo del envío a domicilio en pesos
COSTO_ENVIO=0
# Unidades por debajo de las cuales se avisa "stock bajo"
STOCK_MINIMO=5
# WhatsApp del negocio (solo dígitos con indicativo, ej. 573001234567): activa los botones "Escribir por WhatsApp"
WHATSAPP=
# Correo(s) del equipo que reciben los avisos (separados por coma). Si se deja vacío, se usa el correo de cada administrador
ADMIN_NOTIFY_EMAIL=

# ── Sesiones (opcionales) ──
# Duración de cada token (formato jsonwebtoken: 2h, 90m...)
SESION_DURACION=2h
# Segundos antes del vencimiento a partir de los cuales la API entrega un token renovado
SESION_UMBRAL_RENOVACION_S=1800
# Horas máximas que dura una sesión desde el inicio de sesión, aunque se siga usando
SESION_VIDA_MAXIMA_HORAS=24

# ── Correo (opcional) ──
# SMTP propio en vez de Gmail: si se define MAIL_HOST se usa este servidor (MAIL_USER/MAIL_PASS como credenciales)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
# Remitente; por defecto "STAMPLAB <MAIL_USER>"
MAIL_FROM=
# Solo pruebas: MAIL_MODO=archivo guarda los correos en memoria en vez de enviarlos (ignorado en producción)
MAIL_MODO=

# ── Datos para transferir (se muestran al cliente al pagar y en Mis compras) ──
PAGO_BANCO=
PAGO_TIPO_CUENTA=
PAGO_CUENTA=
PAGO_TITULAR=
PAGO_DOCUMENTO=
PAGO_NOTA=

# ── Operación (opcionales) ──
# Zona horaria del negocio para fechas en correos e indicadores (formato +HH:MM)
ZONA_HORARIA=-05:00
# 1 = no correr tareas programadas (vencimientos, limpieza de diseños); útil en pruebas o en réplicas extra
JOBS_DESACTIVADOS=
# Máximo de imágenes de diseño que un usuario puede subir por hora (el administrador no tiene límite)
DISENOS_MAX_HORA=30
# Horas tras las que se borra una imagen de diseño subida que ninguna cotización usa
DISENOS_HUERFANOS_HORAS=24

# ── Solo desarrollo ──
# 1 = imprimir las consultas SQL
DB_LOGGING=
# Carpeta de respaldos (por defecto backend/respaldos)
RESPALDO_DIR=
# Administrador inicial que crea el seed
ADMIN_EMAIL=admin@stamplab.com
ADMIN_DOC=1000000001
# ADMIN_PASSWORD=cambiar
